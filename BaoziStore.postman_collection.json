{
  "info": {
    "name": "Baozi Store - Atividade Prática",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST - Criar clientes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Lucas Gusmão5164369\",\n  \"clienteDesde\": \"2026-11-25\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Criar produtos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de porco\",\n  \"preco\": 8.5,\n  \"estoque\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"produtoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Criar pedidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Listar clientes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/clientes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Consultar clientes",
