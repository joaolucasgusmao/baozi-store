              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - clientes",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/clientes/{{clienteId}}"
      },
      "event": [
        {
          "listen": "test",
